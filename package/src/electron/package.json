{
  "name": "bla-judge-client",
  "version": "1.0.0",
  "description": "BLA 评委端桌面客户端",
  "main": "dist/main.js",
  "author": "BLA Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build:exe": "tsc && electron-builder --win --config"
  },
  "build": {
    "appId": "com.bla.judge-client",
    "productName": "BLA 评委端",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "app-config.json",
        "to": "app-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null,
      "artifactName": "BLA评委端-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BLA 评委端",
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerHeader": null
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.0"
  }
}
