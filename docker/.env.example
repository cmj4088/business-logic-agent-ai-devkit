# Business Logic Agent — Docker 环境变量配置
# 复制此文件为 .env 并修改配置:
#   cp docker/.env.example .env
#
# 生产环境请务必修改以下配置:
#   1. JWT_SECRET — 随机生成一个长字符串
#   2. FERNET_KEY — 随机生成 32 字节 base64 编码密钥
#   3. OLLAMA_BASE_URL — 指向你的 Ollama 服务地址

# ---- 前端 ----
# API 基础 URL（空字符串 = 同域代理，由 Nginx 转发到后端）
VITE_API_BASE_URL=

# ---- 后端 ----
# 应用
APP_NAME=Business Logic Agent
APP_VERSION=0.1.0
DEBUG=false

# CORS（生产环境改为前端实际访问地址）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,app://.

# 安全（⚠️ 生产环境必须修改）
JWT_SECRET=ipd-agent-studio-jwt-secret-key-2026
FERNET_KEY=4IrjwMT6Qr6-Pe2-M-fEBhiq1vdII3xWh6sg2eJItn0=

# 数据库
DATABASE_PATH=data/ipd_agent.db

# LLM — Ollama（本地部署推荐）
LLM_DEFAULT=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen2.5

# 日志
LOG_LEVEL=INFO

# ---- 端口 ----
BACKEND_PORT=8000
FRONTEND_PORT=80
